rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /saves/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /trainers/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'x', 'y', 'caught', 'level', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 24
        && request.resource.data.x is int && request.resource.data.x >= 0 && request.resource.data.x < 160
        && request.resource.data.y is int && request.resource.data.y >= 0 && request.resource.data.y < 120
        && request.resource.data.caught is int && request.resource.data.caught >= 0 && request.resource.data.caught <= 8
        && request.resource.data.level is int && request.resource.data.level >= 1 && request.resource.data.level <= 100
        && request.resource.data.updatedAt == request.time;
    }
  }
}
